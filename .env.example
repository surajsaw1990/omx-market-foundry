# ---------------------------------------------------------------------------
# Market Foundry — environment configuration. Copy to .env.local for local dev.
# Every variable is optional: with none set, the app runs on embedded PGlite
# with the rule-based analyzer and the demo access code "omx-review".
# ---------------------------------------------------------------------------

# --- LLM (Groq free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# auto (Groq if key present, else heuristic) | groq | heuristic
# LLM_PROVIDER=auto
# LLM_TIMEOUT_MS=25000

# --- Database ---
# PostgreSQL connection string (Neon / Vercel Postgres / Supabase / local).
# Leave empty to use embedded PGlite (data dir below, or "memory").
DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite

# --- Auth ---
# Shared code reviewers use to sign in, and the secret that signs session cookies.
REVIEWER_ACCESS_CODE=omx-review
SESSION_SECRET=change-me-to-a-long-random-string
# Show the access code on the login page (useful for a public demo; set false otherwise)
# SHOW_DEMO_ACCESS_CODE=true

# --- Discovery tuning ---
# DISCOVERY_MAX_ITEMS_PER_RUN=8        # LLM analyses per run (free-tier friendly)
# DISCOVERY_MAX_ITEMS_PER_SOURCE=25
# DISCOVERY_PREFILTER_THRESHOLD=0.3
# DISCOVERY_COOLDOWN_SECONDS=20
# SOURCE_TIMEOUT_MS=8000

# --- Market creation boundary ---
# Empty = in-process mock OmniMarketX API. Set to a base URL to call over HTTP,
# e.g. https://<your-app>.vercel.app/api/mock-omx
# OMX_API_URL=
# OMX_API_KEY=mock-omx-key
# Simulate upstream outages of the mock API (0..1)
# MOCK_OMX_FAILURE_RATE=0

# --- Scheduled discovery (Vercel Cron sends Authorization: Bearer $CRON_SECRET) ---
# CRON_SECRET=

# LOG_LEVEL=info
